```dotenv
# Example environment configuration for ML-Drift-Lens
# Never put real passwords, API keys, or tokens in this file.

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ml_drift_lens

# MLflow
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=ModelWatch-IDS
MLFLOW_REGISTERED_MODEL_NAME=ModelWatch-IDS-Baseline

# Node.js backend
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis
REDIS_URL=redis://localhost:6379

# Retraining
DRIFT_RETRAINING_ENABLED=false

# ML inference service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=5000
INFERENCE_HOST=127.0.0.1
INFERENCE_PORT=8000
MODEL_ARTIFACT_PATH=ml/artifacts/model.joblib

# Logging
LOG_LEVEL=INFO

# Frontend
VITE_API_URL=http://localhost:3000
```
