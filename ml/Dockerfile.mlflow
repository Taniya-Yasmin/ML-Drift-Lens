FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=10

RUN pip install --no-cache-dir --only-binary=:all: --prefer-binary \
    --timeout 120 --retries 10 \
    sqlalchemy==2.0.52 \
    mlflow==2.22.5

RUN mkdir -p /mlflow && chown 1000:1000 /mlflow

EXPOSE 5000
