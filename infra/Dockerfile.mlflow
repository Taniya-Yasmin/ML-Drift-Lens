# Tiny image just for running the MLflow tracking server.
# Pinned to the same mlflow version used by the Python ML services.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install "mlflow==3.15.0"

EXPOSE 5000

# /mlflow is the mount point for the named volume (mlflow_data).
# Backend store: SQLite inside the volume so it survives restarts.
# Artifact store: /mlflow/artifacts (also in the volume).
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health')" || exit 1

CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--host", "0.0.0.0", \
     "--port", "5000"]
