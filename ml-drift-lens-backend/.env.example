# Express backend — service-level env vars.
# In Docker, these are injected by docker-compose.yml (no .env file needed).
# For local development, copy this file to .env and fill in real values.

# Database — must match the postgres service credentials
DB_USER=postgres
DB_PASSWORD=changeMe123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ml_drift_lens

# ML services (used for future backend → ML calls)
ML_SERVICE_URL=http://localhost:8000

NODE_ENV=development
