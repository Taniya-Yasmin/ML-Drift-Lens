# ML Python services — env vars.
# In Docker, these are injected by docker-compose.yml.
# For local development, copy to .env and fill in values.

# URL of the Express monitoring API (no trailing slash)
EXPRESS_API_URL=http://localhost:3000/api
EXPRESS_API_TIMEOUT=5

# MLflow tracking server (used by ml-retrain service)
MLFLOW_TRACKING_URI=http://localhost:5000

# Which FastAPI app this process serves (overridden per-container in compose)
APP_MODULE=app.main:app
APP_PORT=8000

# Optional: local traffic-generator scripts (app/send_*.py)
PREDICT_URL=http://127.0.0.1:8000/predict
